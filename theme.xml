<!--  video do menu principal do tema  -->
<video name="video" extra="true">
     <path>{random}</path>  
     <pos>0.8610 0.785</pos>
     <origin>0.5 0.5</origin>
	 <size>0.220 0.250</size>
     <delay>1</delay>
     <zIndex>6</zIndex>
