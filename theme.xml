<!--  Roleta tela inicial  -->
<carousel name="systemcarousel">
		<defaultTransition>instant</defaultTransition>
	    <pos>0.025 0.015</pos>
        <size>1 0.92</size>
		<type>vertical</type>
        <zIndex>5000</zIndex>         
        <logoScale>1.05</logoScale> 
        <logoSize>0.13 0.135</logoSize>
        <color>00000000</color>
        <logoAlignment>left</logoAlignment>
        <maxLogoCount>7</maxLogoCount>
        <logoRotation>6</logoRotation>		
</carousel>

<image name="logo">
<storyboard event="activate">
<animation property="scale" from="1.0" to="1.90" begin="300" duration="200" mode="Linear"/>
<animation property="x" to="0.02" begin="300" duration="200" mode="linear"/>
<animation property="opacity" to="1" begin="0" duration="500" mode="Linear"/>
</storyboard>

<storyboard event="scroll">
<animation property="opacity" from="1" to="0.2" begin="300" duration="500" mode="Linear"/>
</storyboard>

<!--storyboard event="deactivate">
<animation property="opacity" from="1" to="0" begin="10" duration="500" mode="Linear"/>
</storyboard-->

</image>



<!--  Ponteira tela inicial  -->
<image name="pointer" extra="true">
<pos>0.001 0.419</pos>
<maxSize>0.1 0.1</maxSize>
<path>./_art/pointer_home/default.png</path>
<path>./_art/pointer_home/${system.theme}.png</path>
<path>./_art/pointer_home/${system.theme}.webp</path>
<zIndex>8</zIndex>
<storyboard repeat="forever">
<animation property="x" from="0.001" to="0.008" duration="50" autoreverse="true" begin="1500" repeat="1"/>
</storyboard>
</image>


