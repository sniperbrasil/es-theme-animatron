<theme>

<formatVersion>7</formatVersion>

<!-- mostrar controle e pistola conectada -->
	<view name="screen">

		<controllerActivity name="controllerActivity">
			<pos>0.350 0.015</pos>
			<size>0.100 0.04</size>
			<!--<horizontalAlignment>right</horizontalAlignment>-->
			<itemSpacing>0.003</itemSpacing>
			<imagePath>./_art/icons/gamepad.png</imagePath>
			<gunPath>./_art/icons/gun.png</gunPath>
			<color>ffff00</color>
			<activityColor>ffffff</activityColor>
			<hotkeyColor>${userDarkColor}</hotkeyColor>
		</controllerActivity>
		<controllerActivity name="controllerActivity" tinyScreen="true">
			<visible>false</visible>
		</controllerActivity>
		
	</view>	
    
