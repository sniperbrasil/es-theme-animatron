</image>

<!--  Exibe equipamento  -->
<image name="hardware" extra="static">
			<origin>0 0</origin>
			<pos>0.28 0.70</pos>
			<!--size>0.220 0.230</size-->
			<maxSize>0.220 0.230</maxSize>
			<path>./_art/_hardware/${system.theme}.png</path>
			<linearSmooth>true</linearSmooth>
			<zIndex>5</zIndex>
			<storyboard> 
			<animation property="y" from="0.60" begin="300" duration="1000" mode="Bump"/>
			<animation property="rotation" from="-3" to="3" duration="1000" autoreverse="true" begin="300" repeat="forever"/>
			</storyboard> 
		</image>

<!--  Exibe quantidade de jogos do sistema  -->	  
 <text name="systemInfo">
		<glowColor>000000</glowColor>
		<origin>0.5 0.5</origin>
        <pos>0.620 0.880</pos>
        <backgroundColor>00000000</backgroundColor>
        <color>ffff00</color>
	    <rotation>0</rotation> 
        <fontPath>./_art/font/gobold-blocky-regular.otf</fontPath>
	    <fontSize>0.040</fontSize>
        <zIndex>5</zIndex>
</text>   

<!--  Tipo de Hardware  -->	
<text name="infoTIPOplataforma" extra="true">
<fontSize>0.040</fontSize>
<backgroundRoundCorners>0.25</backgroundRoundCorners>
<minSize>0.10 0.10</minSize>
<opacity>50</opacity>
<fontPath>./_art/font/gobold-blocky-regular.otf</fontPath>
<pos>0.620 0.820</pos>
<origin>0.5 0.5</origin>
<text>{system:hardwareType}</text>
<text if="${system.hardwareType} == 'arcade'">* ARCADES *</text>
<text if="${system.hardwareType} == 'console'">* CONSOLES *</text>
<text if="${system.hardwareType} == 'computer'">* COMPUTADORES *</text>
<text if="${system.hardwareType} == 'extension'">* EXTENSÃO *</text>
<text if="${system.hardwareType} == 'pinball'">* PINBALL *</text>
<text if="${system.hardwareType} == 'port'">* PORT *</text>
<text if="${system.hardwareType} == 'portable'">* PORTATEIS *</text>
<text if="${system.hardwareType} == 'auto collection'">* COLEÇÃO AUTOMATICA *</text>
<text if="${system.hardwareType} == 'custom collection'">* COLEÇÃO PESSOAL *</text>
<text if="${system.hardwareType} == 'retrobat'">* EMULADORES *</text>
<Alignment>right</Alignment>
<glowColor>ffffff</glowColor>
<glowSize>3</glowSize>
<zIndex>200</zIndex>
</text>

